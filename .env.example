# Copy to .env and fill in. Never commit .env.
# Only needed for --live runs; everything else runs offline with the mock model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional knobs
SDR_PROMPT_VERSION=v2
SDR_MAX_REVISIONS=3
SDR_MAX_TOKENS_PER_RUN=80000
SDR_MAX_COST_USD_PER_RUN=0.75
SDR_DB_PATH=data/queue.db
